rule r08_motif_only_loss:
    input:
        sequences=rules.r02_select_top_test_sequences.output.npz,
        top_tsv=rules.r02_select_top_test_sequences.output.tsv,
        motif_bed=lambda wc: _motif_hits_top(wc.exp_id),
        model=MODEL,
        evaluate_json=rules.r02_select_top_test_sequences.input.evaluate_json,
        chromsizes=CHROM_SIZES,
    output:
        tsv=exp_path("{exp_id}", "intermediate", "08_motif_only_losses.tsv"),
        bws=MOTIF_ONLY_BWS,
    params:
        script="03_naive_motif_removal/scripts/08_motif_only_loss.py",
        python_bin=BPNET_PYTHON,
        count_loss_weight=lambda wc, input: _count_loss_weight(input.evaluate_json),
        device=DEVICE,
        shuffle_mode=lambda wc: EXPERIMENTS[wc.exp_id]["shuffle_mode"],
        channel_names=CHANNELS,
    shell:
        """
        {params.python_bin} {params.script} \
            --input-npz {input.sequences} \
            --top-tsv {input.top_tsv} \
            --motif-bed {input.motif_bed} \
            --model {input.model} \
            --count-loss-weight {params.count_loss_weight} \
            --output-tsv {output.tsv} \
            --chrom-sizes {input.chromsizes} \
            --output-bws {output.bws} \
            --device {params.device} \
            --shuffle-mode {params.shuffle_mode}
        """


