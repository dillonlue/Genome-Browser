import csv
import json
import os
from pathlib import Path

from snakemake.io import directory

PYTHON_BIN = os.environ.get("PYTHON_BIN", "python")
CHROMBPNET_PYTHON = os.environ.get("CHROMBPNET_PYTHON", PYTHON_BIN)
BPNET_PYTHON = os.environ.get("BPNET_PYTHON", PYTHON_BIN)

TOP_N = 10
WINDOW_SPAN = 2114
DEVICE = os.environ.get("DEVICE", "cuda")

EVAL_JSON = "02_train/results/01_bpnet_paper/01_bpnet_paper.evaluate.json"
MODISCO_H5 = "02_train/results/01_bpnet_paper/01_bpnet_paper_modisco_results.h5"
MODEL = "02_train/results/01_bpnet_paper/01_bpnet_paper.final.torch"
ATTR_NPZ = "02_train/results/01_bpnet_paper/01_bpnet_paper.attributions.attr.npz"
OHE_NPZ = "02_train/results/01_bpnet_paper/01_bpnet_paper.attributions.ohe.npz"
ATTR_JSON = "02_train/results/01_bpnet_paper/01_bpnet_paper.bpnet.attribute.json"
ATTR_IDXS = "02_train/results/01_bpnet_paper/01_bpnet_paper.attributions.idxs.npy"

GENOME_FASTA = (
    "01_download_data/raw_data/01_zenodo_3371216_data/data/"
    "mm10_no_alt_analysis_set_ENCODE.fasta"
)
CHROM_SIZES = "01_download_data/raw_data/01_zenodo_3371216_data/data/mm10.chrom.sizes"


def shared_path(*parts):
    return str(Path("03_naive_motif_removal/shared").joinpath(*parts))


def exp_path(exp_id, *parts):
    return str(Path("03_naive_motif_removal/experiments") / exp_id / Path(*parts))


def summary_path(*parts):
    return str(Path("03_naive_motif_removal/output/30_experiment_summary").joinpath(*parts))


def _load_experiments(path):
    experiments = []
    with open(path, "r") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        for row in reader:
            contrib_val = row.get("contrib_threshold", "")
            row["contrib_threshold"] = (
                float(contrib_val) if contrib_val not in ("", None) else None
            )
            row["min_log_odds"] = float(row["min_log_odds"])
            experiments.append(row)
    return experiments


def _experiments_map(path):
    return {row["experiment_id"]: row for row in _load_experiments(path)}


def _motif_hits_top(exp_id):
    if EXPERIMENTS[exp_id]["contrib_threshold"] is None:
        return exp_path(exp_id, "intermediate", "07_modisco_motif_hits_top.bed")
    return exp_path(
        exp_id, "intermediate", "07b_modisco_motif_hits_top_filtered.bed"
    )


def _motif_hits_all(exp_id):
    if EXPERIMENTS[exp_id]["contrib_threshold"] is None:
        return exp_path(exp_id, "intermediate", "21_test_modisco_motif_hits.bed")
    return exp_path(exp_id, "intermediate", "21b_test_modisco_motif_hits_filtered.bed")


def _count_loss_weight(path):
    with open(path, "r") as handle:
        payload = json.load(handle)
    return payload["count_loss_weight"]


def _load_channels(path):
    with open(path, "r") as handle:
        payload = json.load(handle)
    channels = []
    for signal_path in payload["signals"]:
        path_obj = Path(signal_path)
        factor = path_obj.parent.name.replace(" ", "_")
        name = path_obj.name
        if "pos" in name:
            strand = "plus"
        elif "neg" in name:
            strand = "minus"
        else:
            strand = "track"
        channels.append(f"{factor}_{strand}")
    return channels


CHANNELS = _load_channels(EVAL_JSON)

EXPERIMENTS = _experiments_map("03_naive_motif_removal/configs/experiment_defs.tsv")
EXPERIMENT_IDS = list(EXPERIMENTS.keys())

PREDICTED_BWS = [shared_path("intermediate", f"06_predicted_{name}.bw") for name in CHANNELS]
MOTIF_ONLY_BWS = [
    f"03_naive_motif_removal/experiments/{{exp_id}}/intermediate/08_motif_only_{name}.bw"
    for name in CHANNELS
]


rule all:
    input:
        summary_path("main.html"),


rule r01_extract_modisco_meme:
    input:
        h5=MODISCO_H5,
    output:
        meme=shared_path("intermediate", "01_modisco_motifs.meme"),
    params:
        script="03_naive_motif_removal/scripts/01_extract_modisco_motif_meme.py",
    shell:
        """
        {BPNET_PYTHON} {params.script} \
            --modisco-h5 {input.h5} \
            --output-meme {output.meme}
        """


rule r02_select_top_test_sequences:
    input:
        evaluate_json=EVAL_JSON,
    output:
        tsv=shared_path("intermediate", "02_top_random_test_sequences.tsv"),
        npz=shared_path("intermediate", "02_top_random_test_sequences.npz"),
    params:
        script="03_naive_motif_removal/scripts/02_select_top_ctcf_test_sequences.py",
        top_n=TOP_N,
        random_n=TOP_N,
        seed=1234,
        chroms_json=ATTR_JSON,
        attr_idxs=ATTR_IDXS,
        python_bin=BPNET_PYTHON,
    shell:
        """
        {params.python_bin} {params.script} \
            --evaluate-json {input.evaluate_json} \
            --output-tsv {output.tsv} \
            --output-npz {output.npz} \
            --top-n {params.top_n} \
            --random-n {params.random_n} \
            --seed {params.seed} \
            --chroms-json {params.chroms_json} \
            --attr-idxs {params.attr_idxs}
        """


