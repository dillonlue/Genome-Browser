        """


rule r09_genome_browser:
    input:
        regions=rules.r04_build_browser_regions.output.json,
        bed=rules.r04_build_browser_regions.output.bed,
        attr_npz=rules.r03_subset_attributions.output.attr_npz,
        ohe_npz=rules.r03_subset_attributions.output.ohe_npz,
        tracks=rules.r09b_render_track_config.output.config,
        motif_hits=lambda wc: _motif_hits_top(wc.exp_id),
        pwm_scores=rules.r05_scan_pwm_scores.output.bw,
        contrib_window=rules.r05b_contrib_window_sum.output.bw,
        predicted_bws=rules.r06_build_predicted_bigwigs.output.bws,
        motif_only_bws=rules.r08_motif_only_loss.output.bws,
    output:
        main_html=exp_path("{exp_id}", "genome_browser", "09_main.html"),
        summary_tsv=exp_path("{exp_id}", "genome_browser", "09_summary_stats.tsv"),
        indv_plots=directory(exp_path("{exp_id}", "genome_browser", "09_indv_plots")),
    params:
        script="03_naive_motif_removal/scripts/09_ctcf_genome_browser.py",
        output_dir=lambda wc: exp_path(wc.exp_id, "genome_browser", "09_genome_browser"),
        indv_plots_dir=lambda wc: exp_path(wc.exp_id, "genome_browser", "09_indv_plots"),
        workers=1,
        title=lambda wc: f"BPNet motif removal ({wc.exp_id})",
    shell:
        """
        {CHROMBPNET_PYTHON} {params.script} \
            --region-config {input.regions} \
            --track-config {input.tracks} \
            --output-dir {params.output_dir} \
            --num-workers {params.workers} \
            --title \"{params.title}\" \
            --main-html {output.main_html} \
            --indv-plots-dir {params.indv_plots_dir} \
            --summary-tsv {output.summary_tsv}
        """


rule r10_motif_removal_report:
    input:
        losses=rules.r08_motif_only_loss.output.tsv,
        top_tsv=rules.r02_select_top_test_sequences.output.tsv,
        regions=rules.r04_build_browser_regions.output.json,
        browser_plots=rules.r09_genome_browser.output.indv_plots,
        evaluate_json=rules.r02_select_top_test_sequences.input.evaluate_json,
    output:
        main_html=exp_path("{exp_id}", "output", "10_main.html"),
        summary_tsv=exp_path("{exp_id}", "output", "10_summary_stats.tsv"),
        indv_plots=directory(exp_path("{exp_id}", "output", "10_indv_plots")),
    params:
        script="03_naive_motif_removal/scripts/10_render_motif_removal_report.py",
        python_bin=BPNET_PYTHON,
        browser_dir=lambda wc: exp_path(wc.exp_id, "genome_browser", "09_indv_plots"),
        output_dir=lambda wc: exp_path(wc.exp_id, "output"),
        count_loss_weight=lambda wc, input: _count_loss_weight(input.evaluate_json),
    shell:
        """
        {params.python_bin} {params.script} \
            --loss-tsv {input.losses} \
            --top-tsv {input.top_tsv} \
            --region-json {input.regions} \
            --browser-plots-dir {params.browser_dir} \
            --output-dir {params.output_dir} \
            --main-html {output.main_html} \
            --summary-tsv {output.summary_tsv} \
            --indv-plots-dir {output.indv_plots} \
            --count-loss-weight {params.count_loss_weight}
        """


