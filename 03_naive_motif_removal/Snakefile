rule r30_experiment_summary:
    input:
        delta_tables=[
            exp_path(exp_id, "output", "23_delta_histograms", "delta_table.tsv")
            for exp_id in EXPERIMENT_IDS
        ],
        example_reports=[
            exp_path(exp_id, "output", "10_main.html") for exp_id in EXPERIMENT_IDS
        ],
    output:
        main_html=summary_path("main.html"),
        summary_tsv=summary_path("summary_stats.tsv"),
        indv_plots=directory(summary_path("indv_plots")),
    params:
        script="03_naive_motif_removal/scripts/30_render_experiment_summary.py",
        experiment_defs="03_naive_motif_removal/configs/experiment_defs.tsv",
